{
    "name": "@jazario/n8n-nodes-bailey",
    "version": "0.1.2",
    "description": "n8n community nodes for Baileys (WhiskeySockets) WhatsApp Web API",
    "license": "MIT",
    "homepage": "https://github.com/jazarie2/n8n-nodes-bailey",
    "keywords": [
        "n8n-community-node-package",
        "whatsapp",
        "baileys",
        "whiskeysockets",
        "n8n"
    ],
    "author": {
        "name": "jazarie2",
        "email": "jazarie2@users.noreply.github.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jazarie2/n8n-nodes-bailey.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease",
        "test": "jest --testPathPattern='test/unit'",
        "test:unit": "jest --testPathPattern='test/unit'",
        "test:integration": "jest --testPathPattern='test/integration'",
        "test:e2e": "jest --config jest.e2e.config.ts",
        "test:all": "jest",
        "test:coverage": "jest --testPathPattern='test/unit' --coverage"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [
            "dist/credentials/BaileyApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Bailey/Bailey.node.js",
            "dist/nodes/Bailey/BaileyTrigger.node.js"
        ]
    },
    "dependencies": {
        "@types/qrcode": "^1.5.6",
        "@whiskeysockets/baileys": "^7.0.0-rc.9",
        "link-preview-js": "^3.0.5",
        "lru-cache": "^10.4.3",
        "pino": "^9.6.0",
        "proper-lockfile": "^4.1.2",
        "qrcode": "^1.5.4",
        "qrcode-terminal": "^0.12.0"
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.15.3",
        "@types/proper-lockfile": "^4.1.4",
        "@types/qrcode-terminal": "^0.12.2",
        "eslint": "9.25.1",
        "jest": "^29.7.0",
        "prettier": "3.5.3",
        "release-it": "17.11.0",
        "ts-jest": "^29.3.2",
        "typescript": "5.8.3"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
